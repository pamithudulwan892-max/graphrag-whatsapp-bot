# Copy this file to .env and fill in your own values. Never commit .env.

# --- General ---------------------------------------------------------------
COMPANY_NAME=Nilaveli Electronics
# Password for the admin dashboard and API (sent as the X-API-Key header). Change it!
ADMIN_API_KEY=change-me
# Comma-separated dashboard origins allowed to call the API (add your Vercel URL here)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Load the files in sample_data/ when the database is empty (handy on free hosts that reset storage)
SEED_SAMPLE_DOCS=false
# Public HTTPS address of this server, e.g. https://your-name-graphrag-bot.hf.space or your ngrok URL.
# Twilio signs the exact public URL, so set this when running behind a proxy.
PUBLIC_BASE_URL=

# --- LLM ----------------------------------------------------------------------
# auto = use Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set,
# else offline mode (heuristic graph + extractive answers).
LLM_PROVIDER=auto

# Google Gemini, free tier, no card needed (https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude, paid, optional (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=low
EXTRACTION_EFFORT=medium

# --- Retrieval -----------------------------------------------------------------
TOP_K=6
USE_RERANKER=true

# --- WhatsApp ----------------------------------------------------------------
# twilio or meta
WHATSAPP_PROVIDER=twilio
# true = replies are saved to the dashboard Outbox instead of being sent
WHATSAPP_DRY_RUN=true

# Twilio (https://console.twilio.com -> Messaging -> Try it out -> Send a WhatsApp message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API (https://developers.facebook.com -> your app -> WhatsApp -> API Setup)
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
